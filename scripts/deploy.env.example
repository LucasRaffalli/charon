# Copie ce fichier vers scripts/deploy.env (non versionné) et renseigne :

# Hôte SSH du VPS (comme pour ssh/scp)
VPS_HOST=user@ton-vps

# Port SSH (si différent de 22)
VPS_PORT=12345

# URL publique qui sert le dossier /var/www/release/charon
PUBLIC_URL=https://release.lucasraffalli.com/charon

# Dossier web sur le VPS (déjà par défaut, à changer seulement si besoin)
# VPS_DIR=/var/www/release/charon

# Clone local du tap Homebrew (défaut : ../homebrew-charon à côté du projet)
# TAP_DIR=/chemin/vers/homebrew-charon
