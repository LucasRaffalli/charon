{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "charon",
  "version": "0.1.0",
  "identifier": "com.aegis.charon",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/charon/browser"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "charon",
        "width": 900,
        "height": 800,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self' data:",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNzU5NkFFRjU3REIxNzEKUldSeHNYMzFycFoxVHhQMkJMS2Y5QUZ3WjJpMmpEWlFibFZqc0I0NUFBdy8xQk45MkZlSUFuR2wK",
      "endpoints": [
        "https://REMPLACE-MOI.exemple/charon/latest.json"
      ]
    }
  }
}
